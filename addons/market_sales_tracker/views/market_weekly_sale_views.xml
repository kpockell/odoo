<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_market_weekly_sale_list" model="ir.ui.view">
        <field name="name">market.weekly.sale.view.list</field>
        <field name="model">market.weekly.sale</field>
        <field name="arch" type="xml">
            <list string="Weekly Sales">
                <field name="week_ending"/>
                <field name="market_id"/>
                <field name="gross_sales"/>
                <field name="processing_fees"/>
                <field name="booth_fee"/>
                <field name="other_costs"/>
                <field name="net_sales"/>
                <field name="bottles_sold"/>
                <field name="weather"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_market_weekly_sale_form" model="ir.ui.view">
        <field name="name">market.weekly.sale.view.form</field>
        <field name="model">market.weekly.sale</field>
        <field name="arch" type="xml">
            <form string="Weekly Sale Summary">
                <sheet>
                    <group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="market_id"/>
                            <field name="week_ending"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="currency_id"/>
                        </group>
                        <group string="Sales and Costs">
                            <field name="gross_sales"/>
                            <field name="processing_fees"/>
                            <field name="booth_fee"/>
                            <field name="other_costs"/>
                            <field name="net_sales" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <group string="Market Conditions">
                            <field name="weather"/>
                            <field name="estimated_foot_traffic"/>
                            <field name="bottles_sold"/>
                            <field name="best_selling_product"/>
                        </group>
                    </group>
                    <group>
                        <field name="notes" placeholder="Weekly summary notes..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_market_weekly_sale_search" model="ir.ui.view">
        <field name="name">market.weekly.sale.view.search</field>
        <field name="model">market.weekly.sale</field>
        <field name="arch" type="xml">
            <search string="Weekly Sales">
                <field name="name"/>
                <field name="market_id"/>
                <field name="week_ending"/>
                <field name="weather"/>
                <filter
                    string="This Month"
                    name="this_month"
                    domain="[
                        ('week_ending', '&gt;=', context_today().replace(day=1).strftime('%Y-%m-%d')),
                        ('week_ending', '&lt;', (context_today().replace(day=1) + relativedelta(months=1)).strftime('%Y-%m-%d'))
                    ]"
                />
                <filter
                    string="This Year"
                    name="this_year"
                    domain="[
                        ('week_ending', '&gt;=', context_today().replace(month=1, day=1).strftime('%Y-%m-%d')),
                        ('week_ending', '&lt;', (context_today().replace(month=1, day=1) + relativedelta(years=1)).strftime('%Y-%m-%d'))
                    ]"
                />
                <group expand="0" string="Group By">
                    <filter string="By Market" name="group_by_market" context="{'group_by': 'market_id'}"/>
                    <filter string="By Weather" name="group_by_weather" context="{'group_by': 'weather'}"/>
                    <filter string="By Month" name="group_by_month" context="{'group_by': 'week_ending:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_market_weekly_sale_pivot" model="ir.ui.view">
        <field name="name">market.weekly.sale.view.pivot</field>
        <field name="model">market.weekly.sale</field>
        <field name="arch" type="xml">
            <pivot string="Weekly Sales Analysis">
                <field name="market_id" type="row"/>
                <field name="week_ending" type="col" interval="month"/>
                <field name="gross_sales" type="measure"/>
                <field name="net_sales" type="measure"/>
                <field name="bottles_sold" type="measure"/>
                <field name="booth_fee" type="measure"/>
                <field name="processing_fees" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_market_weekly_sale_graph" model="ir.ui.view">
        <field name="name">market.weekly.sale.view.graph</field>
        <field name="model">market.weekly.sale</field>
        <field name="arch" type="xml">
            <graph string="Net Sales by Market and Week" type="line">
                <field name="week_ending" interval="week"/>
                <field name="market_id"/>
                <field name="net_sales" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="action_market_weekly_sale" model="ir.actions.act_window">
        <field name="name">Weekly Sales</field>
        <field name="res_model">market.weekly.sale</field>
        <field name="view_mode">list,form,pivot,graph</field>
        <field name="search_view_id" ref="view_market_weekly_sale_search"/>
    </record>

    <record id="action_market_sales_reporting" model="ir.actions.act_window">
        <field name="name">Market Sales Reporting</field>
        <field name="res_model">market.weekly.sale</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="search_view_id" ref="view_market_weekly_sale_search"/>
        <field name="context">{'group_by': ['market_id', 'week_ending:month']}</field>
    </record>
</odoo>
